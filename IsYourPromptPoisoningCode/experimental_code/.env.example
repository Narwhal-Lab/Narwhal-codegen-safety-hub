# Copy this file to `.env` and fill in your own values, then run:
#   set -a && source .env && set +a
# before launching any of the run_*.py scripts. Do NOT commit `.env`.

# ---------- MySQL backend ----------
DB_NAME=prompt_and_code_security
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
# Table name used by the experiment runners. Change per experiment batch
# if you want to keep historical runs in separate tables.
DB_TABLE_NAME=result_table_710

# ---------- Local vLLM / Ollama servers ----------
# Host where your local model servers listen. The runners assume the
# per-model port mapping defined in custom_model.py (11435..11439).
VLLM_HOST=localhost
# Filesystem prefix containing the open-source model weights, as passed
# to vLLM's `--model` flag. Example: /opt/models/vllm
VLLM_MODEL_BASE=/path/to/your/vllm
# Bearer token for the relay/proxy in front of your local vLLM server.
# Leave blank if your local server does not require authentication.
VLLM_RELAY_API_KEY=

# ---------- Hosted / closed-source models ----------
# Moonshot Kimi
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_API_KEY=

# OpenAI-compatible relay used for Gemini / GPT-4o / Grok / Claude.
# Point this at the official provider endpoints, or at a single
# multi-model proxy of your choice.
LLM_PROXY_URL=https://api.openai.com/v1/chat/completions
LLM_PROXY_API_KEY=
